{
  "name": "saldo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:repo": "node tools/repo-lint.mjs",
    "commitlint": "node tools/commit-lint.mjs",
    "type-coverage": "type-coverage",
    "knip": "knip",
    "backlog": "node tools/backlog.mjs",
    "status:refresh": "node tools/status-block.mjs",
    "status:check": "node tools/status-block.mjs --check",
    "arch:refresh": "node tools/arch-graph.mjs",
    "arch:check": "node tools/arch-graph.mjs --check",
    "db:lint": "node tools/migrations-up.mjs > .migrations-up.sql && squawk --config squawk.toml .migrations-up.sql",
    "db:migrate": "dbmate up",
    "db:migrate:new": "dbmate new",
    "db:rollback": "dbmate down",
    "db:introspect": "pnpm --filter @saldo/web db:introspect",
    "dr:drill": "bash tools/restore-drill.sh",
    "saft:validate": "pnpm --filter @saldo/web saft:validate",
    "mva:validate": "pnpm --filter @saldo/web mva:validate",
    "ehf:validate": "pnpm --filter @saldo/web ehf:validate"
  },
  "typeCoverage": {
    "atLeast": 97,
    "strict": true,
    "ignoreFiles": [
      "apps/web/app/db/schema.ts",
      "apps/web/app/db/relations.ts",
      "**/*.test.ts",
      "apps/web/test/**"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.3",
      "undici": ">=6.27.0",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "12.6.0",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "dbmate": "^2.21.0",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "knip": "6.18.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "squawk-cli": "2.58.0",
    "turbo": "^2.1.3",
    "type-coverage": "2.29.7",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
