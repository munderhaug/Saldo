# ─────────────────────────────────────────────────────────────────────────────
# Saldo — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Reads of .env* are denied to the agent (.claude/settings.json).
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-min

# --- Database (PostgreSQL) ---
# dbmate + app both read DATABASE_URL.
DATABASE_URL=postgres://saldo:saldo@localhost:5432/saldo?sslmode=disable

# --- Object storage (S3-compatible: MinIO / Garage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-north-1
S3_BUCKET=saldo-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (BankID / Vipps Login via Criipto or Signicat, OIDC) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# --- ID-porten (Altinn filing only — NOT app login) ---
IDPORTEN_ISSUER=
IDPORTEN_CLIENT_ID=
IDPORTEN_CLIENT_SECRET=

# --- LLM extraction (OpenAI-compatible endpoint; local Ollama/vLLM or hosted) ---
# Local-first default points at Ollama. Swap base URL for vLLM or a hosted provider.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_VISION_MODEL=qwen2.5-vl
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Email (provider-agnostic SMTP via nodemailer; EU provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Saldo <no-reply@example.no>"

# --- Banking (GoCardless Bank Account Data / PSD2 AIS) ---
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GLITCHTIP_DSN=
