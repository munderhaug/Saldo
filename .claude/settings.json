{
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:introspect)",
      "Bash(pnpm db:lint)",
      "Bash(pnpm saft:*)",
      "Bash(pnpm --filter*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm deploy:*)", "Bash(kamal:*)", "Bash(pnpm db:rollback)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/.env*)", "Read(./secrets/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "./.claude/scripts/block-generated.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "./.claude/scripts/precommit-check.sh" },
          { "type": "command", "command": "./.claude/scripts/lint-repo-on-docs.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "./.claude/scripts/green-bar.sh" }]
      }
    ]
  }
}
